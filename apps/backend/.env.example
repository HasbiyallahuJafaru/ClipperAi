# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=
DEEPSEEK_API_KEY=
BUFFER_API_KEY=

# Accounts (Clerk). The API accepts only Clerk session tokens issued to these sites (comma-separated origins).
# `clerk env pull --file <temp file>` gets the secret key for the linked Clerk app.
CLERK_SECRET_KEY=
CLERK_AUTHORIZED_PARTIES=http://127.0.0.1:3000,http://localhost:3000
# Clerk user or organization ids allowed to publish through BUFFER_API_KEY (it posts to one person's socials).
BUFFER_OWNERS=
# Postgres. Leave blank locally to auto-start a dev database in apps/backend/pgdata (needs pgserver).
DATABASE_URL=
WORKER_CONCURRENCY=1

# Cloudflare R2 (S3 API). Endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
# Publishing: a second bucket with public access switched on (R2: bucket settings -> r2.dev subdomain or a custom
# domain). Buffer can't read signed links, so each post gets a copy here, deleted once it's out.
S3_PUBLIC_BUCKET=
S3_PUBLIC_URL=
